{
  "info": {
    "name": "Level-Up Gamer - EP3/EFT",
    "description": "Coleccion de pruebas de los cuatro microservicios de Level-Up Gamer: login y usuarios (8081), productos y categorias (8082), carrito (8083) y pagos (8085).\n\nOrden recomendado: ejecutar la coleccion completa con el Runner. La carpeta Autenticacion genera los tokens y los IDs que usan las demas carpetas.\n\nCuentas:\n- Administrador: admin@levelup.cl / Admin123!\n- Cliente: se crea automaticamente en el registro aleatorio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseLogin", "value": "http://localhost:8081" },
    { "key": "baseProductos", "value": "http://localhost:8082" },
    { "key": "baseCarrito", "value": "http://localhost:8083" },
    { "key": "basePagos", "value": "http://localhost:8085" },
    { "key": "token", "value": "" },
    { "key": "clienteToken", "value": "" },
    { "key": "clienteId", "value": "" },
    { "key": "usuarioCreadoId", "value": "" },
    { "key": "productoId", "value": "" },
    { "key": "categoriaId", "value": "1" },
    { "key": "ordenAprobada", "value": "1001" },
    { "key": "ordenRechazada", "value": "1002" },
    { "key": "ordenFondos", "value": "1003" },
    { "key": "ordenTransferencia", "value": "1004" }
  ],
  "item": [
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test('entrega un token JWT', () => pm.expect(datos.token).to.be.a('string').and.not.empty);",
                  "pm.test('el rol es ADMIN', () => pm.expect(datos.rol).to.eql('ADMIN'));",
                  "pm.collectionVariables.set('token', datos.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@levelup.cl\",\n  \"password\": \"Admin123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseLogin}}/api/auth/login",
            "description": "Devuelve 200 y el JWT que se usa como Bearer en las demas carpetas."
          }
        },
        {
          "name": "Registro de cliente nuevo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sello = Date.now();",
                  "pm.collectionVariables.set('correoRegistro', `cliente${sello}@levelup.cl`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "const datos = pm.response.json();",
                  "pm.test('el rol asignado es CLIENTE', () => pm.expect(datos.rol).to.eql('CLIENTE'));",
                  "pm.test('no devuelve la contrasena', () => pm.expect(datos.password).to.be.undefined);",
                  "pm.collectionVariables.set('clienteId', datos.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Postman\",\n  \"correo\": \"{{correoRegistro}}\",\n  \"password\": \"Cliente123!\",\n  \"telefono\": \"912345678\",\n  \"region\": \"metropolitana\",\n  \"comuna\": \"Santiago\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseLogin}}/api/usuarios/registro",
            "description": "Registro publico. El correo cambia en cada ejecucion para evitar el 409."
          }
        },
        {
          "name": "Login cliente registrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test('el rol es CLIENTE', () => pm.expect(datos.rol).to.eql('CLIENTE'));",
                  "pm.collectionVariables.set('clienteToken', datos.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoRegistro}}\",\n  \"password\": \"Cliente123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseLogin}}/api/auth/login",
            "description": "Obtiene el token del cliente creado en el paso anterior."
          }
        },
        {
          "name": "Login con contrasena incorrecta (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@levelup.cl\",\n  \"password\": \"ClaveIncorrecta123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseLogin}}/api/auth/login"
          }
        }
      ]
    },
