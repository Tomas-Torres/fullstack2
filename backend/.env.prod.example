# ============================================================
# Level-Up Gamer - Variables para el compose de produccion
# ============================================================
# Copiar como .env en la misma carpeta que docker-compose.prod.yml:
#   cp .env.prod.example .env
# Luego completar PUBLIC_HOST con la IP publica o el dominio de la EC2.

# IP publica o dominio de la instancia (sin http://).
# Ejemplo: 54.123.45.67  o  levelup.midominio.cl
PUBLIC_HOST=localhost

# --- MySQL ---
# La contrasena de root se define al crear el volumen por primera vez.
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-root

# Debe coincidir con el usuario creado en db/init.sql (levelup/levelup).
# Si se cambia aqui, tambien hay que cambiarla en db/init.sql antes del
# primer arranque del contenedor de MySQL.
DB_USER=levelup
DB_PASSWORD=levelup

# --- JWT ---
# Minimo 32 caracteres. Todos los microservicios deben compartir el mismo.
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=120

# --- CORS ---
# Origenes permitidos, separados por coma. Incluir el frontend publicado.
CORS_ORIGINS=http://localhost,http://127.0.0.1
