# Copiar este archivo como .env y ajustar los valores.
# docker compose lee .env automaticamente.

# --- MySQL local (docker compose) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# --- Credenciales de aplicacion (deben coincidir con db/init.sql) ---
DB_USER=levelup
DB_PASSWORD=levelup

# --- JWT (secreto compartido, minimo 32 caracteres) ---
JWT_SECRET=levelup-gamer-dev-secret-key-change-in-production-2026
JWT_EXPIRATION_MINUTES=120

# --- CORS (origenes separados por coma) ---
CORS_ORIGINS=http://localhost:5173
