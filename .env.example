# Copiar este archivo como .env en la raiz antes de levantar el stack:
#   cp .env.example .env
#   nano .env        # cambiar PUBLIC_HOST si tu IP es distinta

# IP publica / Elastic IP de la instancia EC2. El frontend compila estas URLs
# dentro del bundle, por eso debe ser la IP real y no "localhost".
PUBLIC_HOST=184.72.249.146

# MySQL
MYSQL_ROOT_PASSWORD=root
DB_USER=levelup
# DB_PASSWORD debe coincidir con backend/db/init.sql (usuario 'levelup').
DB_PASSWORD=levelup

# Seguridad
JWT_SECRET=levelup-gamer-dev-secret-key-change-in-production-2026
JWT_EXPIRATION_MINUTES=120

# Origenes permitidos por CORS (navegador -> microservicios)
CORS_ORIGINS=http://184.72.249.146,http://localhost,http://127.0.0.1
